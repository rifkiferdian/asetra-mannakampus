APP_NAME=Asetra
APP_ENV=development
APP_PORT=8083
BASE_URL=http://localhost:8083
APP_SECURE_COOKIE=false

# Production requires at least 32 characters. Generate a unique random value
# for every environment and never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=asetra_app
DB_PASS=replace-with-database-password
DB_NAME=asetra_manna_kampus
